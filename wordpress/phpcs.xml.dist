<?xml version="1.0"?>
<ruleset name="Pandlens Adresgegevens">
	<description>WPCS for Pandlens Adresgegevens WordPress plugin.</description>

	<file>pandlens-adresgegevens</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/tests/unit/*</exclude-pattern>
	<exclude-pattern>*/index.php</exclude-pattern>
	<exclude-pattern>*/composer.phar</exclude-pattern>

	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="Squiz.Commenting.FileComment"/>
		<exclude name="Squiz.Commenting.FunctionComment"/>
		<exclude name="Squiz.Commenting.VariableComment"/>
		<exclude name="Generic.Commenting.DocComment"/>
	</rule>

	<rule ref="WordPress.Security.EscapeOutput">
		<exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
	</rule>

	<rule ref="PSR2.Classes.PropertyDeclaration.Underscore">
		<exclude-pattern>*/class-gravity-forms-addon-impl.php</exclude-pattern>
	</rule>

	<rule ref="Generic.CodeAnalysis.UselessOverridingMethod">
		<exclude-pattern>*/class-gravity-forms-addon-impl.php</exclude-pattern>
	</rule>

	<config name="minimum_supported_wp_version" value="6.0"/>
	<config name="testVersion" value="7.4-"/>

	<arg value="sp"/>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>

	<rule ref="PHPCompatibilityWP"/>
</ruleset>
